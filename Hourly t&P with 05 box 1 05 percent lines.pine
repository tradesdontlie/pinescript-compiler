//@version=5
indicator("Hourly Time and Price [JerryG & Smitty]",shorttitle = "Hourly T & P", overlay = true, max_lines_count = 500,
 max_labels_count = 500, max_boxes_count = 500, dynamic_requests=true, max_bars_back=5000)

//========== User inputs =====================================================================

// MFE/MAE Session Enables
G1e = "MFE/MAE Session Enables"
ses_en_tip="Each sessions group of plots can be turned on or off"

i_ses_1_toggle = input.bool(defval = true, title = "H1", inline = "se1", group = G1e,tooltip=ses_en_tip)
i_ses_2_toggle = input.bool(defval = true, title = "H2", inline = "se1", group = G1e,tooltip=ses_en_tip)
i_ses_3_toggle = input.bool(defval = true, title = "H3", inline = "se1", group = G1e,tooltip=ses_en_tip)

i_ses_5_toggle = input.bool(defval = true, title = "3 Hr", inline = "se2", group = G1e,tooltip=ses_en_tip)

// Histogram Enables
GhisEn = "3 Hr MFE Histogram"
i_hist_1_toggle = false
i_hist_2_toggle = false
i_hist_3_toggle = false

i_hist_5_toggle = input.bool(true, "3 Hr Histogram Enable", inline="hist_enable", group=GhisEn,
 tooltip="3 hour MAE/MFE time histograms that shows what time in the past sessions that the MAE and MFE events occurred\n 
 the MFE histograms go up from the baseline while MFE histograms project down from the baseline")

// Preset Mode Inline Start Time Group: H and M
SessionDay = input.string("All", "Day of week filter", options=["Mon","Tue","Wed","Thur","Fri","All"],
 tooltip="Analysis can be day filtered or use all days for calculations")

GPre="MFE/MAE 3Hr Sessions Setup"
// preset_mode = input.bool(true, "Use Session Presets",  group=GPre,
//  tooltip="Check this box to setup all 5 sessions automatically\nNOTE:This overrides manual sessions setup when checked
//  \nWhat it does: Sets session 5 as HTF start time and length in mins then sets 3 or 4 LTF sub-sessions inside the HTF session span")
preset_mode = true
startHour   = input.int(9, "3Hr Start-   Hr", minval=0, maxval=23, inline="startTime", group=GPre)
startMinute = input.int(0, "min", minval=0, maxval=59, inline="startTime", group=GPre,
 tooltip="This sets the start time of the 3 Hr Session")
// sessionLength = input.int(240, "HTF Length (minutes)", options=[30, 60, 120, 180, 240, 270, 480, 720], group=GPre,
//  tooltip="This sets the duration of the HTF session")
sessionLength=180
// sessionMode = input.string("quarters", "LTF Sub-Sessions inside HTF", options=["quarters", "thirds"], group=GPre,
//  tooltip="When set to quarters it sets up 4 LTF subsessions inside the HTF session span\nwhen set to thirds
//  it sets up 3 LTF subsessions inside the HTF session. For example setting start time to 10 00 and HTF session length
//  to 240 and LTF subessions to quarters will set session 5 to 4 hours long starting at 10:00AM and put 4 x 1 hour 
//  subsessions inside it")
sessionMode = "thirds"
// SessionDay = input.string("All", "Day of week for Same Day", options=["Mon","Tue","Wed","Thur","Fri","All"])
// G1 = "Manual Session Setup (MUST uncheck Session Presets above)"
// SessionDay = "All" // default free indicator to all days only

// ses_tip="Manually setup each individual session's time span.\nNote that line styles and coloring occurs in two
//  groups. Sessions 1 - 4 are one group of colors and line styles and Session 5 is a separate set of coloring and line
//  syles.  This faciitates the possiblity of having session 5 as a Higher Timeframe session (HTF) and sessions 1 through
//  4 as Lower Timeframe Sessions (LTF)"
// i_ses_1 = input.session(defval = "0600-0615", title = "Session 1 (LTF)", inline = "s1", group = G1, tooltip=ses_tip)
// i_ses_2 = input.session(defval = "0615-0630", title = "Session 2 (LTF)", inline = "s2", group = G1, tooltip=ses_tip)

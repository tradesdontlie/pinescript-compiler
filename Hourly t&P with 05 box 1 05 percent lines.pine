// i_ses_5 = input.session(defval = "0600-0700", title = "Session 5 (HTF)", inline = "s5", group = G1, tooltip=ses_tip)
i_ses_1 = "0600-0615"
i_ses_2 = "0615-0630"
i_ses_3 = "0630-0645"
i_ses_4 = "0645-0700"
i_ses_5 = "0600-0700"


G2 = "MFE/MAE Calculations Settings"
i_calc_mode = input.string(defval = "Both", title = "Calculation Mode", options = ["Med", "Avg", "Both"], group = G2,
 tooltip="When plotting MFE/MAE lines you can choose to plot the data set's average, or median, or both\nWhat
 it does?: Assume you have 10 data points then it displays the average of that data or median or both")
i_bands_type = "Probability"
i_bands_toggle = input.bool(defval = true, title = "Show MFE Target Zones Sess H1-3", inline="MFEbands",group = G2)
i_bands_box_color = input.color(defval = color.new(color.green, 80), title = "", inline = "MFEbands", group = G2)
i_s5_bands_toggle = input.bool(defval = true, title = "Show MFE Target Zone Sess 3Hr", inline="S5MFEbands",group = G2)
i_s5_bands_box_color = input.color(defval = color.new(color.aqua, 80), title = "", inline = "S5MFEbands", group = G2)
i_custom_bands_toggle = input.bool(defval = false, title = "Show Custom Probability MFE Zone", inline="CustomBands", group = G2)
i_custom_bands_color = input.color(defval = color.new(color.blue, 70), title = "", inline = "CustomBands", group = G2)
i_custom_prob_lower = input.int(defval = 30, title = "Cust Zone Lower % ", minval = 0, maxval = 100, step = 1, group = G2, inline="probcust")
i_custom_prob_upper = input.int(defval = 10, title = "Upper %", minval = 0, maxval = 100, step = 1, group = G2, inline="probcust")

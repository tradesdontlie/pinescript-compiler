var line session_lines_5_end = na



// === CONSTANTS ===


//========== Functions ========================================================================




// === FUNCTION: FORMAT HHMM ===
f_fmt_hhmm(totalMins) =>
    hh = math.floor(totalMins / 60) % 24
    mm = math.floor(totalMins % 60)
    str.tostring(hh, "00") + str.tostring(mm, "00")

// === Helper: Get Day Number for SessionDay ===
getDayNumber(day) =>
    day == "Mon" ? 2 :
     day == "Tue" ? 3 :
     day == "Wed" ? 4 :
     day == "Thur" ? 5 :
     day == "Fri" ? 6 :
     na


// === Adjusted Session Day Append Logic ===
getSessionSuffix(session, selectedDay) =>
    endTimeStr = str.substring(session, 5, 9)  // characters 5–8 = HHMM end time
    endHour = str.tonumber(str.substring(endTimeStr, 0, 2))
    endMin  = str.tonumber(str.substring(endTimeStr, 2, 4))
    endsAfterMidnight = endHour >= 0 and endHour < 18  // Futures usually end before 18:00
    dayNum = getDayNumber(selectedDay)
    adjustedDayNum = (selectedDay != "All" and not na(dayNum)) ? (endsAfterMidnight ? dayNum : dayNum - 1) : na
    adjustedDayNum := adjustedDayNum == 0 ? 7 : adjustedDayNum
    suffix = (selectedDay == "All" or na(adjustedDayNum)) ? "" : ":" + str.tostring(adjustedDayNum)
    session + suffix




f_line_style(input_var) =>
    switch input_var
        "dotted" => line.style_dotted
        "dashed" => line.style_dashed
        => line.style_solid



i_range_style = f_line_style(i_range_style_str)
i_s5_range_style = f_line_style(i_s5_range_style_str)
i_sess_box_style = f_line_style(i_sess_box_style_str)
i_s5_sess_box_style = f_line_style(i_s5_sess_box_style_str)
i_sess_mid_style = f_line_style(i_sess_mid_style_str)
i_s5_sess_mid_style = f_line_style(i_s5_sess_mid_style_str)

open_style = f_line_style(i_open_style)
m_style    = f_line_style(i_m_style)
d_style    = f_line_style(i_d_style)
t_style    = f_line_style(i_t_style)
// Add these new conversions for quarter lines
qtrs_style = f_line_style(i_qtrs_style)
s5_open_style = f_line_style(i_s5_open_style)
s5_m_style    = f_line_style(i_s5_m_style)
s5_d_style    = f_line_style(i_s5_d_style)
